---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description: string;
  nav?: "home" | "page";
  mainClass?: string;
}

const { title, description, nav = "page", mainClass = "" } = Astro.props;
---

<!doctype html>
<html lang="ms" class="scroll-smooth bg-navy">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09111e" />
  </head>

  <body
    class="flex min-h-dvh flex-col bg-navy font-sans text-white antialiased selection:bg-accent selection:text-navy"
  >
    <a
      href="#kandungan-utama"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-accent focus:px-4 focus:py-3 focus:font-display focus:text-lg focus:font-extrabold focus:uppercase focus:text-navy"
    >
      Langkau ke kandungan utama
    </a>

    <SiteHeader nav={nav} />

    <main id="kandungan-utama" class={`flex-1 ${mainClass}`}>
      <slot />
    </main>

    <Footer />
  </body>
</html>
