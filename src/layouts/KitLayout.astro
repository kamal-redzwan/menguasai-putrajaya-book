---
// Built on tasteskill 2.5.1 (MIT, github.com/Leonxlnx/taste-skill). Kit files live in public/assets.
// type: product (a printed book sold online), site-kind other.
// deal: hero photo (a generated chart, no photographs fetched by request), nav-split, close-photo,
//       footer-dark, rhythm brand-band, buttons pill, mark stack; moments pinned-chapters + word-highlight.
// palette: the client's own colours from the book jacket (start.mjs brand): paper #f4f1ea, navy ink #09111e,
//       yellow #facc15. type: urbanist (the first pairing start.mjs dealt), self-hosted.
import "@fontsource-variable/urbanist";

export interface Props {
  title: string;
  description: string;
  home?: boolean;
  moments?: string[];
}

const { title, description, home = false, moments = [] } = Astro.props;
const to = (id: string) => (home ? `#${id}` : `/#${id}`);
const year = new Date().getFullYear();

const policies = [
  { href: "/polisi-penghantaran", label: "Polisi penghantaran" },
  { href: "/polisi-pemulangan", label: "Polisi pemulangan" },
  { href: "/terma-dan-syarat", label: "Terma dan syarat" },
  { href: "/polisi-privasi", label: "Polisi privasi" },
];
---

<!doctype html>
<html lang="ms" data-type="product" data-radius="soft" data-buttons="pill" data-motion>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/share.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f4f1ea" />
    <meta name="site-kind" content="other" />
    <meta name="page-type" content="product" />
    <link rel="stylesheet" href="/assets/system.css" />
    <link rel="stylesheet" href="/assets/ui/cards.css" />
    <link rel="stylesheet" href="/assets/motion/motion.css" />
    <link rel="stylesheet" href="/assets/layout/layout.css" />
    <link rel="stylesheet" href="/assets/icons/icon.css" />
    <style is:inline>
      :root {
        --p-bg: #f4f1ea; --p-surface: #e6e4df; --p-ink: #09111e; --p-muted: #5f646b;
        --p-accent: #facc15; --p-accent-ink: #09111e; --p-action: #09111e; --p-action-ink: #f4f1ea;
        --p-inv-bg: #09111e; --p-inv-surface: #161e2a; --p-inv-ink: #f4f1ea; --p-inv-muted: #909396;
        --p-inv-accent: #facc15; --p-inv-accent-ink: #09111e; --p-inv-action: #facc15; --p-inv-action-ink: #09111e;
        --font-display: "Urbanist Variable", system-ui, sans-serif;
        --font-text: "Urbanist Variable", system-ui, sans-serif;
        --display-weight: 400;
        --display-tracking: -0.03em;
        --display-tracking-xl: -0.04em;
      }
    </style>
    <slot name="head" />
    <script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
    {
      moments.length > 0 && (
        <>
          <script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
          <link rel="modulepreload" href="/assets/moments/moments.js" />
          <link rel="modulepreload" href="/assets/moments/lib.js" />
          {moments.map((id) => <link rel="modulepreload" href={`/assets/moments/${id}/moment.js`} />)}
        </>
      )
    }
  </head>
  <body>
    <header class="nav nav--split">
      <div class="wrap nav__bar">
        <a class="skip-link" href="#top">Langkau ke kandungan</a>
        <a class="nav__logo" href={home ? "#top" : "/"}><span class="mark" data-mark="stack" aria-hidden="true"></span><span class="nav__name">Menguasai Putrajaya</span></a>
        <nav class="nav__links" aria-label="Utama">
          <div class="nav__item">
            <a class="nav__link" href={to("buku")}>Buku <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
            <div class="nav__menu">
              <div class="wrap grid">
                <a class="menu-card span-3" href={to("buku")}>
                  <div class="panel"><img class="frame__img" src="/img/buku-kulit-depan-belakang.jpg" alt="Kulit hadapan dan belakang buku Siapa Akan Menguasai Putrajaya?" loading="lazy" /></div>
                  <span class="t-card">Buku dan butirannya</span>
                  <span class="t-small muted">430 muka surat, ISBN 978-967-5131-28-8</span>
                </a>
                <a class="menu-card span-3" href={to("kaedah")}>
                  <div class="panel"><img class="frame__img" src="/img/bab-peta-meja.jpg" alt="Tangan menyusun bidak pada meja skrin peta kawasan pilihan raya" loading="lazy" /></div>
                  <span class="t-card">Cara buku ini membaca PRU</span>
                  <span class="t-small muted">Data, peta kerusi dan senario</span>
                </a>
                <a class="menu-card span-3" href={to("video")}>
                  <div class="panel"><img class="frame__img" style="object-position: 50% 30%" src="/poster-video-01.jpg" alt="Penyampai berdiri di hadapan skrin peta Malaysia" loading="lazy" /></div>
                  <span class="t-card">Dua sorotan video</span>
                  <span class="t-small muted">Sebelum anda membaca</span>
                </a>
              </div>
            </div>
          </div>
          <div class="nav__item"><a class="nav__link" href={to("sinopsis")}>Sinopsis</a></div>
          <div class="nav__item"><a class="nav__link" href={to("kaedah")}>Kaedah</a></div>
          <div class="nav__item"><a class="nav__link" href={to("soalan")}>Soalan</a></div>
        </nav>
        <div class="nav__actions">
          <a class="btn btn--primary" href={to("tempah")}>Tempah buku</a>
        </div>
        <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        </button>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer class="footer closing footer--dark ground-inverse" id="contact" aria-labelledby="close-h">
      <div class="wrap">
        <!-- close: close-photo dealt; with no photographs on the page it becomes close-word's head row without the
             name (sections.md section 2) -->
        <div class="closing__cta close--word">
          <div class="section-head--split">
            <div>
              <h2 id="close-h">Tempah buku sebelum cetakan pertama habis</h2>
              <p class="t-lead">RM56 ke Semenanjung, RM70 ke Sabah dan Sarawak, pos termasuk.</p>
            </div>
            <a class="btn btn--primary" href={to("tempah")}>Tempah buku<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8" /><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5" /></svg></a>
          </div>
        </div>
        <div class="closing__links">
          <div class="grid">
            <div class="span-4 stack-4">
              <a class="nav__logo" href={home ? "#top" : "/"}><span class="mark" data-mark="stack" aria-hidden="true"></span>Menguasai Putrajaya</a>
              <p class="footer__lede">Buku politik karya Ronifira Rejab.</p>
            </div>
            <div class="span-2 footer__col">
              <h3>Buku</h3>
              <ul>
                <li><a href={to("buku")}>Butiran</a></li>
                <li><a href={to("sinopsis")}>Sinopsis</a></li>
                <li><a href={to("kaedah")}>Kaedah</a></li>
                <li><a href={to("video")}>Video</a></li>
              </ul>
            </div>
            <div class="span-2 footer__col">
              <h3>Tempahan</h3>
              <ul>
                <li><a href={to("tempah")}>Borang tempahan</a></li>
                <li><a href={to("soalan")}>Soalan lazim</a></li>
              </ul>
            </div>
            <div class="span-2 footer__col">
              <h3>Polisi</h3>
              <ul>
                {policies.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
              </ul>
            </div>
            <div class="span-2 footer__col">
              <h3>Hubungi</h3>
              <ul>
                <li><a href="tel:+60108725969">+6010 872 5969</a></li>
                <li><a href="mailto:ronifira@gmail.com">ronifira@gmail.com</a></li>
              </ul>
              <address class="footer__addr">2-1B, Jalan UP1/1, Ukay Perdana, 68000 Ampang, Selangor</address>
            </div>
          </div>
          <div class="footer__legal">
            <span>&copy; {year} Brainwave Communications (202203208117 / JM0967023-W)</span>
            <span>Pembayaran melalui CHIP Collect</span>
          </div>
        </div>
      </div>
    </footer>

    <style is:inline>
      /* a 19-character name: under 400px the bar shows the mark alone (system.css: the client shortens it to its mark) */
      @media (max-width: 399px) { .nav__bar .nav__name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; } }
      .footer__addr { margin-top: var(--s-4); font-style: normal; font-size: var(--t-small); color: var(--muted); line-height: 1.5; }
    </style>
    <script is:inline type="module" src="/assets/system.js"></script>
    <script is:inline type="module" src="/assets/motion/motion.js"></script>
    <script is:inline type="module" src="/assets/layout/layout.js"></script>
  </body>
</html>
