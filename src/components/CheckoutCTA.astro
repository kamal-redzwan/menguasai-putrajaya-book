---
export interface Props {
  totalQuota?: number;
}

const { totalQuota = 200 } = Astro.props;
const resolvedBrandId =
  import.meta.env.PUBLIC_CHIP_BRAND_ID ||
  import.meta.env.CHIP_BRAND_ID ||
  "db3280df-c2eb-48e5-bdcb-b757e269de69";

const fieldClass =
  "mt-2 min-h-[48px] w-full border-2 border-navy bg-white px-3 py-2.5 text-base text-navy placeholder:text-on-paper-muted";
const labelClass = "block font-bold text-navy";

const policyLinks = [
  { href: "/terma-dan-syarat", label: "Terma & Syarat" },
  { href: "/polisi-penghantaran", label: "Polisi Penghantaran" },
  { href: "/polisi-pemulangan", label: "Polisi Pemulangan" },
  { href: "/polisi-privasi", label: "Polisi Privasi" },
];
---

<section
  id="tempahan"
  aria-labelledby="checkout-heading"
  class="surface-paper border-t-2 border-white bg-paper text-navy"
>
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-16 sm:px-6 md:grid-cols-12 md:gap-10 md:py-24 lg:px-8"
  >
    <div class="md:col-span-5">
      <p aria-hidden="true" class="font-display text-8xl font-extrabold leading-none text-navy/15">
        03
      </p>
      <h2
        id="checkout-heading"
        class="mt-2 font-display text-[clamp(2.25rem,5vw,3.5rem)] font-extrabold uppercase leading-[0.95]"
      >
        Tempah naskhah anda
      </h2>

      <div class="mt-5 space-y-4 text-lg leading-relaxed">
        <p>
          Harga sudah termasuk kos penghantaran. Harga pra-jualan ini untuk{" "}
          {totalQuota} naskhah cetakan pertama sahaja, selepas itu harga biasa
          dikenakan.
        </p>
        <p class="text-on-paper-muted">
          Buku dihantar selepas cetakan selesai: 3 hingga 5 hari bekerja ke
          Semenanjung, 5 hingga 7 hari bekerja ke Sabah dan Sarawak.
        </p>
      </div>

      <div class="mt-8 border-t-2 border-navy pt-4 text-sm leading-relaxed text-on-paper-muted">
        <p>
          Pembayaran melalui CHIP Collect (FPX, DuitNow QR, kad kredit/debit dan
          e-dompet) kepada Brainwave Communications (202203208117 /
          JM0967023-W).
        </p>
        <ul class="mt-2 flex flex-wrap gap-x-4">
          {
            policyLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-[44px] items-center font-semibold text-navy underline decoration-1 underline-offset-4 hover:decoration-2"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <form
      id="chip-checkout-form"
      data-brand-id={resolvedBrandId}
      class="space-y-6 border-2 border-navy bg-white p-5 sm:p-8 md:col-span-7"
      novalidate
    >
      <fieldset>
        <legend class={labelClass}>Zon penghantaran</legend>
        <div class="mt-2 grid grid-cols-1 gap-3 sm:grid-cols-2">
          <label
            class="flex min-h-[64px] items-center justify-between gap-3 border-2 border-navy bg-accent p-4 transition-colors"
            data-region-card="semenanjung"
          >
            <span class="flex items-center gap-3">
              <input
                type="radio"
                name="region"
                value="semenanjung"
                data-price-rm="56"
                checked
                class="h-5 w-5 accent-navy"
              />
              <span>
                <span class="block font-bold">Semenanjung</span>
                <span class="block text-sm">Buku RM48 + pos RM8</span>
              </span>
            </span>
            <span class="font-display text-3xl font-extrabold tabular-nums">RM56</span>
          </label>

          <label
            class="flex min-h-[64px] items-center justify-between gap-3 border-2 border-navy bg-white p-4 transition-colors hover:bg-paper"
            data-region-card="borneo"
          >
            <span class="flex items-center gap-3">
              <input
                type="radio"
                name="region"
                value="borneo"
                data-price-rm="70"
                class="h-5 w-5 accent-navy"
              />
              <span>
                <span class="block font-bold">Sabah &amp; Sarawak</span>
                <span class="block text-sm">Buku RM55 + pos RM15</span>
              </span>
            </span>
            <span class="font-display text-3xl font-extrabold tabular-nums">RM70</span>
          </label>
        </div>
      </fieldset>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <label for="full_name" class={labelClass}>Nama penuh</label>
          <input type="text" id="full_name" name="full_name" autocomplete="name" required placeholder="Nama penerima" class={fieldClass} />
        </div>
        <div>
          <label for="email" class={labelClass}>E-mel</label>
          <input type="email" id="email" name="email" autocomplete="email" required placeholder="emel@contoh.com" class={fieldClass} />
        </div>
        <div>
          <label for="phone" class={labelClass}>Telefon (WhatsApp)</label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" required placeholder="01X XXX XXXX" class={fieldClass} />
        </div>
        <div>
          <label for="quantity" class={labelClass}>Kuantiti</label>
          <select id="quantity" name="quantity" class={fieldClass}>
            <option value="1">1 naskhah</option>
            <option value="2">2 naskhah</option>
            <option value="3">3 naskhah</option>
            <option value="5">5 naskhah</option>
            <option value="10">10 naskhah</option>
          </select>
        </div>
      </div>

      <div>
        <label for="shipping_address" class={labelClass}>Alamat penghantaran</label>
        <textarea
          id="shipping_address"
          name="shipping_address"
          autocomplete="street-address"
          rows="3"
          required
          placeholder="No. rumah, jalan, poskod, bandar dan negeri"
          class={fieldClass}
        ></textarea>
      </div>

      <p class="text-sm text-on-paper-muted">Semua ruangan wajib diisi.</p>

      <div class="flex items-end justify-between gap-4 border-t-4 border-navy pt-4">
        <div>
          <p class="font-bold">Jumlah bayaran</p>
          <p id="summary-unit-price" class="text-sm tabular-nums text-on-paper-muted">RM56.00 / naskhah</p>
        </div>
        <p id="summary-total-price" class="font-display text-5xl font-extrabold tabular-nums leading-none">
          RM56.00
        </p>
      </div>

      <div id="checkout-status" role="status" aria-live="polite" class="hidden border-2 p-4 text-sm"></div>

      <button
        type="submit"
        id="submit-payment-btn"
        class="flex min-h-[60px] w-full items-center justify-center bg-accent px-6 font-display text-2xl font-extrabold uppercase text-navy transition-colors hover:bg-navy hover:text-accent active:translate-y-px disabled:cursor-not-allowed disabled:opacity-60"
      >
        <span id="submit-btn-text">Bayar RM56.00</span>
      </button>
    </form>
  </div>
</section>

<script>
  // CHIP Collect API expects unit prices in integer sen (e.g. RM56.00 = 5600).
  interface ChipProduct {
    name: string;
    price: number;
    quantity: number;
  }

  interface ChipPurchasePayload {
    brand_id: string;
    client: {
      email: string;
      full_name: string;
      phone: string;
      street_address?: string;
      shipping_street_address: string;
    };
    purchase: {
      currency: "MYR";
      products: ChipProduct[];
      notes: string;
    };
    success_redirect: string;
    failure_redirect: string;
    success_callback?: string;
  }

  interface ChipPurchaseResponse {
    id?: string;
    status?: string;
    checkout_url?: string;
    message?: string;
  }

  const form = document.querySelector<HTMLFormElement>("#chip-checkout-form");
  const regionRadios = document.querySelectorAll<HTMLInputElement>(
    'input[name="region"]',
  );
  const quantitySelect = document.querySelector<HTMLSelectElement>("#quantity");
  const unitPriceEl = document.querySelector<HTMLElement>(
    "#summary-unit-price",
  );
  const totalPriceEl = document.querySelector<HTMLElement>(
    "#summary-total-price",
  );
  const submitBtn = document.querySelector<HTMLButtonElement>(
    "#submit-payment-btn",
  );
  const submitBtnText = document.querySelector<HTMLElement>("#submit-btn-text");
  const statusBox = document.querySelector<HTMLElement>("#checkout-status");
  const regionCards =
    document.querySelectorAll<HTMLElement>("[data-region-card]");

  const getSelectedPriceRM = (): number => {
    const checked = document.querySelector<HTMLInputElement>(
      'input[name="region"]:checked',
    );
    return checked ? Number(checked.dataset.priceRm || 56) : 56;
  };

  const getSelectedQuantity = (): number => {
    return quantitySelect ? Number(quantitySelect.value || 1) : 1;
  };

  const updatePricingSummary = (): void => {
    const unitPrice = getSelectedPriceRM();
    const quantity = getSelectedQuantity();
    const totalRM = unitPrice * quantity;

    if (unitPriceEl) {
      unitPriceEl.textContent = `RM${unitPrice.toFixed(2)} / naskhah`;
    }
    if (totalPriceEl) {
      totalPriceEl.textContent = `RM${totalRM.toFixed(2)}`;
    }
    if (submitBtnText) {
      submitBtnText.textContent = `Bayar RM${totalRM.toFixed(2)}`;
    }

    regionCards.forEach((card) => {
      const input = card.querySelector<HTMLInputElement>(
        'input[name="region"]',
      );
      const isChecked = Boolean(input?.checked);
      card.classList.toggle("bg-accent", isChecked);
      card.classList.toggle("bg-white", !isChecked);
      card.classList.toggle("hover:bg-paper", !isChecked);
    });
  };

  regionRadios.forEach((radio) => {
    radio.addEventListener("change", updatePricingSummary);
  });

  quantitySelect?.addEventListener("change", updatePricingSummary);

  const showStatus = (
    prefix: string,
    message: string,
    isError = false,
  ): void => {
    if (!statusBox) return;
    statusBox.classList.remove("hidden", "border-red-700", "bg-red-50", "text-red-800", "border-navy", "bg-paper", "text-navy");
    if (isError) {
      statusBox.classList.add("border-red-700", "bg-red-50", "text-red-800");
    } else {
      statusBox.classList.add("border-navy", "bg-paper", "text-navy");
    }
    statusBox.textContent = `${prefix}: ${message}`;
  };

  form?.addEventListener("submit", async (event: SubmitEvent) => {
    event.preventDefault();
    if (!form) return;

    const formData = new FormData(form);
    const fullName = String(formData.get("full_name") || "").trim();
    const email = String(formData.get("email") || "").trim();
    const phone = String(formData.get("phone") || "").trim();
    const address = String(formData.get("shipping_address") || "").trim();
    const region = String(formData.get("region") || "semenanjung");

    if (!fullName || !email || !phone || !address) {
      showStatus(
        "Ralat Pengesahan Borang",
        "Sila lengkapkan Nama Penuh, Alamat E-mel, Nombor Telefon dan Alamat Penghantaran sebelum meneruskan pembayaran.",
        true,
      );
      return;
    }

    const unitPriceRM = getSelectedPriceRM();
    const quantity = getSelectedQuantity();
    const regionLabel =
      region === "borneo" ? "Sabah & Sarawak" : "Semenanjung Malaysia";
    const totalPriceRM = (unitPriceRM * quantity).toFixed(2);
    const cleanAddress = address.replace(/\s+/g, " ");
    const truncatedAddress = cleanAddress.slice(0, 128);

    const chipPayload: ChipPurchasePayload = {
      brand_id: form.dataset.brandId || "db3280df-c2eb-48e5-bdcb-b757e269de69",
      client: {
        email,
        full_name: fullName,
        phone,
        street_address: truncatedAddress,
        shipping_street_address: truncatedAddress,
      },
      purchase: {
        currency: "MYR",
        products: [
          {
            name: `Siapa Akan Menguasai Putrajaya? (${regionLabel})`,
            price: unitPriceRM * 100,
            quantity,
          },
        ],
        notes: `Nama: ${fullName} | Tel: ${phone} | E-mel: ${email} | Zon: ${regionLabel} | Kuantiti: ${quantity} naskhah | Jumlah: RM${totalPriceRM} | Alamat: ${cleanAddress}`,
      },
      success_redirect: `${window.location.origin}/berjaya`,
      failure_redirect: `${window.location.origin}/?status=gagal#tempahan`,
      success_callback: `${window.location.origin}/api/webhook`,
    };

    if (submitBtn) submitBtn.disabled = true;
    if (submitBtnText)
      submitBtnText.textContent = "Menghubungi CHIP Collect...";
    showStatus(
      "Memuatkan",
      "Sedang menghubungi gerbang pembayaran CHIP Collect. Sila tunggu sebentar...",
    );

    try {
      const response = await fetch("/api/checkout", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(chipPayload),
      });

      const data = (await response.json()) as ChipPurchaseResponse;

      if (response.ok && data.checkout_url) {
        showStatus(
          "Status Berjaya",
          "Mengalihkan anda ke halaman pembayaran rasmi CHIP Collect...",
        );
        window.location.href = data.checkout_url;
        return;
      }

      showStatus(
        "Makluman Konfigurasi CHIP Collect",
        data.message ||
          `Butiran tempahan untuk ${fullName} (Jumlah: RM${(unitPriceRM * quantity).toFixed(2)}) telah disahkan. Sila tetapkan CHIP_SECRET_KEY dan CHIP_BRAND_ID pada pelayan untuk pengalihan pembayaran langsung.`,
        !response.ok,
      );
    } catch {
      showStatus(
        "Ralat Sambungan Pelayan",
        `Tidak dapat menghubungi titik akhir /api/checkout. Sila semak sambungan internet anda atau cuba sebentar lagi.`,
        true,
      );
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      updatePricingSummary();
    }
  });
</script>
