---
const coverImage = "/COVER 16 copy 2.jpg";

const bookFacts = [
  { label: "Muka surat", value: "430" },
  { label: "ISBN", value: "978-967-5131-28-8" },
  { label: "Penerbit", value: "Brainwave Communications & Prestasi Media" },
  { label: "Cetakan pertama", value: "200 naskhah" },
];
---

<section id="utama" aria-labelledby="hero-heading" class="bg-navy">
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 pb-12 pt-10 sm:px-6 md:grid-cols-12 md:items-center md:gap-8 md:pb-16 md:pt-14 lg:px-8"
  >
    <div class="md:col-span-7">
      <h1
        id="hero-heading"
        class="font-display text-[clamp(3.25rem,10vw,7.25rem)] font-extrabold uppercase leading-[0.88] text-white"
      >
        Siapa akan <span class="block text-accent">menguasai</span> Putrajaya?
      </h1>

      <p class="mt-5 max-w-xl text-lg font-medium leading-snug text-on-navy-muted sm:text-xl">
        Rahsia, analisis, data dan strategi menjelang PRU 16. Karya{" "}
        <span class="font-bold text-white">Ronifira Rejab</span>.
      </p>

      <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4 border-t-2 border-white pt-5">
        <div>
          <dt class="text-sm text-on-navy-muted">Semenanjung, termasuk pos</dt>
          <dd class="font-display text-5xl font-extrabold tabular-nums text-white">RM56</dd>
        </div>
        <div>
          <dt class="text-sm text-on-navy-muted">Sabah &amp; Sarawak, termasuk pos</dt>
          <dd class="font-display text-5xl font-extrabold tabular-nums text-white">RM70</dd>
        </div>
      </dl>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
        <a
          href="#tempahan"
          class="inline-flex min-h-[56px] items-center justify-center bg-accent px-8 font-display text-2xl font-extrabold uppercase text-navy transition-colors hover:bg-white active:translate-y-px"
        >
          Tempah naskhah anda
        </a>
        <a
          href="#sinopsis"
          class="inline-flex min-h-[44px] items-center justify-center font-semibold text-white underline decoration-2 underline-offset-4 transition-colors hover:text-accent"
        >
          Baca sinopsis dahulu
        </a>
      </div>
      <p class="mt-4 text-sm text-on-navy-faint">
        Harga pra-jualan untuk 200 naskhah cetakan pertama.
      </p>
    </div>

    <div class="md:col-span-5">
      <img
        src={encodeURI(coverImage)}
        alt="Kulit hadapan buku Siapa Akan Menguasai Putrajaya? karya Ronifira Rejab"
        width="760"
        height="1064"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="mx-auto aspect-[760/1064] h-auto w-full max-w-[300px] shadow-[14px_14px_0_0_rgba(255,255,255,0.14)] sm:max-w-[360px] md:max-w-none"
      />
    </div>
  </div>

  <dl
    class="border-y-2 border-white"
    aria-label="Butiran buku"
  >
    <div
      class="mx-auto grid max-w-6xl grid-cols-2 px-4 sm:px-6 md:grid-cols-4 lg:px-8"
    >
      {
        bookFacts.map((fact, i) => (
          <div
            class={`py-4 pr-4 ${i % 2 === 1 ? "pl-4 border-l border-white/30" : ""} ${i >= 2 ? "border-t border-white/30 md:border-t-0" : ""} ${i === 2 ? "md:border-l md:pl-4" : ""}`}
          >
            <dt class="text-sm text-on-navy-faint">{fact.label}</dt>
            <dd class="mt-0.5 font-display text-xl font-semibold uppercase leading-tight text-white">
              {fact.value}
            </dd>
          </div>
        ))
      }
    </div>
  </dl>
</section>
