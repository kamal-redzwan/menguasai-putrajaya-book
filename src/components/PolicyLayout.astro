---
import BaseLayout from "../layouts/BaseLayout.astro";

export interface Props {
  title: string;
  enTitle: string;
  description: string;
  currentPath: string;
  lastUpdated?: string;
}

const {
  title,
  enTitle,
  description,
  currentPath,
  lastUpdated = "15 November 2026",
} = Astro.props;

const pageTitle = `${title} (${enTitle}) | Siapa Akan Menguasai Putrajaya?`;

const policyNav = [
  { href: "/polisi-penghantaran", label: "Penghantaran" },
  { href: "/polisi-pemulangan", label: "Pemulangan" },
  { href: "/terma-dan-syarat", label: "Terma & Syarat" },
  { href: "/polisi-privasi", label: "Privasi" },
];
---

<BaseLayout title={pageTitle} description={description} mainClass="surface-paper bg-paper text-navy">
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <nav aria-label="Dokumen polisi" class="border-b-2 border-navy">
      <ul class="-mb-[2px] flex flex-wrap gap-x-1">
        {
          policyNav.map((item) => {
            const isCurrent = item.href === currentPath;
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent ? "page" : undefined}
                  class={`inline-flex min-h-[44px] items-center border-b-4 px-2 font-display text-lg font-semibold uppercase transition-colors ${
                    isCurrent
                      ? "border-navy text-navy"
                      : "border-transparent text-on-paper-muted hover:border-on-paper-rule hover:text-navy"
                  }`}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <article class="mt-10">
      <header>
        <h1 class="font-display text-[clamp(2.75rem,8vw,4.5rem)] font-extrabold uppercase leading-[0.92]">
          {title}
        </h1>
        <p class="mt-3 text-sm text-on-paper-muted">
          {enTitle}. Kemas kini terakhir {lastUpdated}. Dikeluarkan oleh
          Brainwave Communications (202203208117 / JM0967023-W).
        </p>
      </header>

      <div class="doc mt-10 font-serif text-lg leading-[1.7]">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>
