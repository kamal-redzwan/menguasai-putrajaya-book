---
const currentYear = new Date().getFullYear();

const policyLinks = [
  { href: "/polisi-penghantaran", label: "Polisi Penghantaran" },
  { href: "/polisi-pemulangan", label: "Polisi Pemulangan & Bayaran Balik" },
  { href: "/terma-dan-syarat", label: "Terma dan Syarat" },
  { href: "/polisi-privasi", label: "Polisi Privasi" },
];

const linkClass =
  "inline-flex min-h-[44px] items-center text-white underline decoration-white/40 decoration-1 underline-offset-4 transition-colors hover:decoration-accent hover:decoration-2";
---

<footer class="border-t-2 border-white bg-navy text-on-navy-muted">
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-12 sm:px-6 md:grid-cols-12 md:gap-8 lg:px-8"
  >
    <div class="md:col-span-5">
      <p class="font-display text-3xl font-extrabold uppercase leading-none text-white">
        Menguasai Putrajaya
      </p>
      <p class="mt-3 max-w-sm leading-relaxed">
        Diterbitkan dan diedarkan oleh Brainwave Communications (202203208117 /
        JM0967023-W) bersama Prestasi Media.
      </p>
      <address class="mt-3 not-italic leading-relaxed">
        2-1B, Jalan UP1/1, Ukay Perdana,<br />
        68000 Ampang, Selangor.
      </address>
    </div>

    <div class="md:col-span-3">
      <h2 class="font-display text-xl font-extrabold uppercase text-white">Hubungi</h2>
      <ul class="mt-2">
        <li>
          <a href="tel:+60108725969" class={`${linkClass} tabular-nums`}>+6010 872 5969</a>
        </li>
        <li>
          <a href="mailto:ronifira@gmail.com" class={linkClass}>ronifira@gmail.com</a>
        </li>
      </ul>
    </div>

    <nav aria-label="Polisi" class="md:col-span-4">
      <h2 class="font-display text-xl font-extrabold uppercase text-white">Polisi</h2>
      <ul class="mt-2">
        {
          policyLinks.map((link) => (
            <li>
              <a href={link.href} class={linkClass}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/20">
    <p class="mx-auto max-w-6xl px-4 py-5 text-sm text-on-navy-faint sm:px-6 lg:px-8">
      &copy; {currentYear} Brainwave Communications. Hak cipta terpelihara.
    </p>
  </div>
</footer>
