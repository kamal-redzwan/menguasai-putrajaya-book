---
export interface Props {
  nav?: "home" | "page";
}

const { nav = "page" } = Astro.props;
const onHome = nav === "home";

const homeLinks = [
  { href: "#sinopsis", label: "Sinopsis" },
  { href: "#tonton", label: "Tonton" },
];

const linkClass =
  "inline-flex min-h-[44px] items-center px-2 font-display text-lg font-semibold uppercase text-on-navy-muted transition-colors hover:text-white";
const buyClass =
  "inline-flex min-h-[44px] items-center bg-accent px-5 font-display text-lg font-extrabold uppercase text-navy transition-colors hover:bg-white active:translate-y-px";
---

<header class="sticky top-0 z-50 border-b-2 border-white bg-navy">
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 px-4 py-2 sm:px-6 lg:px-8"
  >
    <a
      href="/"
      class="inline-flex min-h-[44px] items-center font-display text-xl font-extrabold uppercase leading-none text-white"
    >
      Menguasai Putrajaya
    </a>

    {
      onHome ? (
        <>
          <button
            type="button"
            id="mobile-menu-btn"
            aria-expanded="false"
            aria-controls="main-nav"
            aria-label="Buka menu"
            class="inline-flex h-11 w-11 items-center justify-center border-2 border-white text-white transition-colors hover:bg-white hover:text-navy sm:hidden"
          >
            <svg
              data-icon-open
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path d="M3 6h18M3 12h18M3 18h18" />
            </svg>
            <svg
              data-icon-close
              class="hidden h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path d="M5 5l14 14M19 5L5 19" />
            </svg>
          </button>

          <nav
            id="main-nav"
            aria-label="Navigasi utama"
            class="hidden w-full flex-col gap-1 border-t border-white/30 py-3 sm:flex sm:w-auto sm:flex-row sm:items-center sm:gap-4 sm:border-0 sm:py-0"
          >
            {homeLinks.map((link) => (
              <a href={link.href} class={linkClass}>
                {link.label}
              </a>
            ))}
            <a href="#tempahan" class={`${buyClass} mt-2 justify-center sm:mt-0`}>
              Tempah
            </a>
          </nav>
        </>
      ) : (
        <nav aria-label="Navigasi utama" class="flex items-center gap-2 sm:gap-4">
          <a href="/" class={`${linkClass} hidden sm:inline-flex`}>
            Laman utama
          </a>
          <a href="/#tempahan" class={buyClass}>
            Tempah
          </a>
        </nav>
      )
    }
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const nav = document.getElementById("main-nav");
  const iconOpen = btn?.querySelector("[data-icon-open]");
  const iconClose = btn?.querySelector("[data-icon-close]");

  if (btn && nav && iconOpen && iconClose) {
    const setOpen = (open: boolean): void => {
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Tutup menu" : "Buka menu");
      nav.classList.toggle("hidden", !open);
      nav.classList.toggle("flex", open);
      iconOpen.classList.toggle("hidden", open);
      iconClose.classList.toggle("hidden", !open);
    };

    btn.addEventListener("click", () => {
      setOpen(btn.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        if (window.innerWidth < 640) setOpen(false);
      });
    });

    document.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        btn.focus();
      }
    });
  }
</script>
