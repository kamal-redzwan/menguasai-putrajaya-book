---
export interface Props {
  src: string;
  caption: string;
  label?: string;
  poster?: string;
}

const { src, caption, label = "Analisis Visual", poster } = Astro.props;
const encodedSrc = encodeURI(src);
---

<figure class="mx-auto my-8 w-full max-w-sm sm:my-10">
  <div class="mb-3 flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-slate-300">
    <span class="text-yellow-400">{label}</span>
    <span>Klik video untuk audio</span>
  </div>

  <div
    data-scroll-video-wrapper
    class="relative overflow-hidden rounded-2xl border border-slate-500 bg-slate-900 shadow-2xl shadow-black/70"
  >
    <video
      data-scroll-video
      src={encodedSrc}
      poster={poster}
      width="478"
      height="850"
      muted
      loop
      playsinline
      preload="metadata"
      class="aspect-[478/850] h-auto w-full cursor-pointer bg-slate-950 object-cover"
      aria-label={caption}
    >
      Pelayar anda tidak menyokong main balik video HTML5.
    </video>

    <div class="flex items-center justify-between gap-2.5 border-t border-slate-700 bg-slate-950/95 p-3">
      <button
        type="button"
        data-playback-toggle
        aria-pressed="false"
        class="inline-flex min-h-[44px] w-[44px] items-center justify-center rounded-lg border border-slate-500 bg-slate-900 text-slate-300 transition hover:border-slate-300 hover:bg-slate-800 hover:text-white active:translate-y-px focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-400"
        aria-label="Mainkan atau Jeda Video"
      >
        <svg
          data-icon-play
          class="hidden h-5 w-5"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 4L19 12L5 20V4Z" fill="currentColor" />
        </svg>
        <svg
          data-icon-pause
          class="h-5 w-5"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M8 5V19M16 5V19" />
        </svg>
      </button>

      <button
        type="button"
        data-sound-toggle
        aria-pressed="false"
        class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-lg border border-slate-500 bg-slate-900 px-3.5 py-2 text-xs font-semibold text-white transition hover:border-yellow-400 hover:bg-slate-800 active:translate-y-px focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-400"
      >
        <svg
          data-icon-muted
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 text-yellow-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"
          />
        </svg>

        <svg
          data-icon-unmuted
          xmlns="http://www.w3.org/2000/svg"
          class="hidden h-4 w-4 text-yellow-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
          />
        </svg>

        <span data-sound-label>Suara Dimatikan</span>
      </button>
    </div>
  </div>

  <figcaption class="mt-3.5 text-center text-sm leading-relaxed text-slate-300">
    {caption}
  </figcaption>
</figure>

<script>
  const videoWrappers = document.querySelectorAll<HTMLElement>(
    "[data-scroll-video-wrapper]",
  );
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );

  const videoObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (
          entry.isIntersecting &&
          !prefersReducedMotion.matches &&
          video.dataset.userPaused !== "true"
        ) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    },
    { threshold: 0.45 },
  );

  videoWrappers.forEach((wrapper) => {
    // Guard against duplicate listener attachment when multiple instances exist on the page.
    if (wrapper.dataset.initialized === "true") return;
    wrapper.dataset.initialized = "true";

    const video = wrapper.querySelector<HTMLVideoElement>(
      "[data-scroll-video]",
    );
    const soundBtn = wrapper.querySelector<HTMLButtonElement>(
      "[data-sound-toggle]",
    );
    const soundLabel = wrapper.querySelector<HTMLElement>("[data-sound-label]");
    const playbackBtn = wrapper.querySelector<HTMLButtonElement>(
      "[data-playback-toggle]",
    );
    const iconPlay = wrapper.querySelector<SVGElement>("[data-icon-play]");
    const iconPause = wrapper.querySelector<SVGElement>("[data-icon-pause]");
    const iconMuted = wrapper.querySelector<SVGElement>("[data-icon-muted]");
    const iconUnmuted = wrapper.querySelector<SVGElement>(
      "[data-icon-unmuted]",
    );

    if (!video) return;

    videoObserver.observe(video);

    const syncSoundUI = (): void => {
      const isMuted = video.muted;
      if (soundLabel) {
        soundLabel.textContent = isMuted ? "Suara Dimatikan" : "Suara Aktif";
      }
      if (soundBtn) {
        soundBtn.setAttribute("aria-pressed", String(!isMuted));
      }
      if (iconMuted && iconUnmuted) {
        iconMuted.classList.toggle("hidden", !isMuted);
        iconUnmuted.classList.toggle("hidden", isMuted);
      }
    };

    const syncPlaybackUI = (): void => {
      const isPaused = video.paused;
      if (iconPlay && iconPause) {
        iconPlay.classList.toggle("hidden", !isPaused);
        iconPause.classList.toggle("hidden", isPaused);
      }
      if (playbackBtn) {
        playbackBtn.setAttribute("aria-pressed", String(isPaused));
      }
    };

    const toggleSound = (): void => {
      video.muted = !video.muted;
      if (video.paused && !prefersReducedMotion.matches) {
        video.dataset.userPaused = "false";
        video.play().catch(() => {});
      }
      syncSoundUI();
    };

    video.addEventListener("click", toggleSound);
    soundBtn?.addEventListener("click", toggleSound);

    playbackBtn?.addEventListener("click", () => {
      if (video.paused) {
        video.dataset.userPaused = "false";
        video.play().catch(() => {});
      } else {
        video.dataset.userPaused = "true";
        video.pause();
      }
      syncPlaybackUI();
    });

    video.addEventListener("play", syncPlaybackUI);
    video.addEventListener("pause", syncPlaybackUI);
    syncPlaybackUI();
  });
</script>
