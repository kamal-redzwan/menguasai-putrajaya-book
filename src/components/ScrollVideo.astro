---
export interface Props {
  src: string;
  poster: string;
  title: string;
  caption: string;
}

const { src, poster, title, caption } = Astro.props;
---

<figure data-scroll-video-wrapper class="w-full">
  <div class="border-2 border-white">
    <video
      data-scroll-video
      src={encodeURI(src)}
      poster={poster}
      width="478"
      height="850"
      muted
      loop
      playsinline
      preload="metadata"
      class="aspect-[478/850] h-auto w-full bg-black object-cover"
      aria-label={`Video: ${title}`}
    >
      Pelayar anda tidak menyokong video HTML5.
    </video>

    <div class="flex items-center justify-between gap-2 border-t-2 border-white p-2">
      <button
        type="button"
        data-playback-toggle
        class="inline-flex h-11 w-11 items-center justify-center text-white transition-colors hover:bg-white hover:text-navy"
        aria-label="Jeda video"
      >
        <svg data-icon-play class="hidden h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 4l14 8-14 8V4z" fill="currentColor"></path>
        </svg>
        <svg data-icon-pause class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 4h4v16H6zM14 4h4v16h-4z" fill="currentColor"></path>
        </svg>
      </button>

      <button
        type="button"
        data-sound-toggle
        aria-pressed="false"
        class="inline-flex min-h-[44px] items-center gap-2 px-3 font-display text-lg font-semibold uppercase text-white transition-colors hover:bg-white hover:text-navy"
      >
        <svg data-icon-muted class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor" stroke="none"></path>
          <path d="M17 9l5 6M22 9l-5 6"></path>
        </svg>
        <svg data-icon-unmuted class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor" stroke="none"></path>
          <path d="M16 9a4 4 0 010 6M19 6a8 8 0 010 12"></path>
        </svg>
        <span data-sound-label>Buka suara</span>
      </button>
    </div>
  </div>

  <figcaption class="mt-4">
    <span class="block font-display text-2xl font-extrabold uppercase leading-tight text-white">
      {title}
    </span>
    <span class="mt-1 block leading-relaxed text-on-navy-muted">{caption}</span>
  </figcaption>
</figure>

<script>
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (
          entry.isIntersecting &&
          !prefersReducedMotion.matches &&
          video.dataset.userPaused !== "true"
        ) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    },
    { threshold: 0.45 },
  );

  document.querySelectorAll<HTMLElement>("[data-scroll-video-wrapper]").forEach((wrapper) => {
    const video = wrapper.querySelector<HTMLVideoElement>("[data-scroll-video]");
    const playBtn = wrapper.querySelector<HTMLButtonElement>("[data-playback-toggle]");
    const soundBtn = wrapper.querySelector<HTMLButtonElement>("[data-sound-toggle]");
    const soundLabel = wrapper.querySelector<HTMLElement>("[data-sound-label]");
    const iconPlay = wrapper.querySelector("[data-icon-play]");
    const iconPause = wrapper.querySelector("[data-icon-pause]");
    const iconMuted = wrapper.querySelector("[data-icon-muted]");
    const iconUnmuted = wrapper.querySelector("[data-icon-unmuted]");
    if (!video) return;

    observer.observe(video);

    const syncPlayback = (): void => {
      iconPlay?.classList.toggle("hidden", !video.paused);
      iconPause?.classList.toggle("hidden", video.paused);
      playBtn?.setAttribute("aria-label", video.paused ? "Mainkan video" : "Jeda video");
    };

    const syncSound = (): void => {
      if (soundLabel) soundLabel.textContent = video.muted ? "Buka suara" : "Tutup suara";
      soundBtn?.setAttribute("aria-pressed", String(!video.muted));
      iconMuted?.classList.toggle("hidden", !video.muted);
      iconUnmuted?.classList.toggle("hidden", video.muted);
    };

    playBtn?.addEventListener("click", () => {
      if (video.paused) {
        video.dataset.userPaused = "false";
        video.play().catch(() => {});
      } else {
        video.dataset.userPaused = "true";
        video.pause();
      }
    });

    soundBtn?.addEventListener("click", () => {
      video.muted = !video.muted;
      if (!video.muted && video.paused) {
        video.dataset.userPaused = "false";
        video.play().catch(() => {});
      }
      syncSound();
    });

    video.addEventListener("play", syncPlayback);
    video.addEventListener("pause", syncPlayback);
    syncPlayback();
    syncSound();
  });
</script>
