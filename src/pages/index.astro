---
// The Storefront homepage (GLOSSARY.md). Rendered on request so the Category section reads EmDash: a Category with
// no Book that is Pre-order or On sale shows as "Akan datang". Featured Books are a static grid for now (Q8).
import KitLayout from "../layouts/KitLayout.astro";
import BookCard from "../components/BookCard.astro";
import { getCategoryShelves, SHOW_PLACEHOLDERS } from "../lib/catalog";

export const prerender = false;

const BOOK = "/umum-politik/menguasai-putrajaya";
const cover = encodeURI("/COVER 16 copy 2.jpg");
const categories = await getCategoryShelves();

// Featured Books: the one real Book, then placeholders marked "Contoh" that never reach the production branch (Q9).
const featured = [
  {
    title: "Siapa Akan Menguasai Putrajaya?",
    author: "Ronifira Rejab",
    category: "Umum Politik",
    availability: "Pra-tempahan",
    priceSemenanjung: 56,
    priceSabahSarawak: 70,
    href: BOOK,
    cover: { src: cover, alt: "Kulit buku Siapa Akan Menguasai Putrajaya?", width: 1748, height: 2480 },
    placeholder: false,
  },
  ...(SHOW_PLACEHOLDERS
    ? ["Umum Motivasi", "Buku Novel Remaja", "Buku Tokoh-tokoh"].map((category) => ({
        title: "Tajuk buku contoh",
        author: "Nama penulis",
        category,
        availability: "Akan datang",
        placeholder: true,
      }))
    : []),
];

// Testimonials: real readers' words with their names only (GLOSSARY.md). None yet, so the section stays hidden.
const testimonials: Array<{ quote: string; name: string; detail: string }> = [];

Astro.response.headers.set("Cache-Control", "public, max-age=60");
---

<KitLayout
  title="Brainwave Communications: kedai buku penerbit di Ampang, Selangor"
  description="Beli buku terbitan Brainwave Communications terus dari penerbit. Siapa Akan Menguasai Putrajaya? karya Ronifira Rejab kini dibuka untuk pra-tempahan."
  home
>
  <style is:inline slot="head">
    /* page CSS: the store hero, the shelf cards and the category tiles */
    .hero--store { display: grid; align-content: center; padding-top: calc(var(--nav) + var(--s-7)); padding-bottom: var(--s-8); }
    .hero-store { align-items: center; }
    .hero-store__label { font-size: var(--t-small); font-weight: 600; color: var(--p-accent); }
    .hero-store__text h1 { margin-top: var(--s-3); font-size: clamp(44px, 5.4vw, 80px); line-height: 1.02; }
    .hero-store__accent { color: var(--p-accent); }
    .hero-store__lead { margin-top: var(--s-5); font-size: var(--t-lead); max-width: 34ch; }
    .hero-store__text .btn-row { margin-top: var(--s-7); }
    .hero-store__pic { margin: 0; border-radius: var(--r-lg); overflow: hidden; aspect-ratio: 4 / 3; }
    .hero-store__pic img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 60% 40%; }
    .cats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); }
    .cat { display: grid; gap: var(--s-2); align-content: space-between; min-height: 132px; padding: var(--s-5); border-radius: var(--r-md);
      border: 1px solid var(--line-strong); color: inherit; text-decoration: none; }
    .cat__name { font-size: var(--t-card, 20px); font-weight: 500; }
    .cat__state { font-size: var(--t-small); color: var(--muted); }
    a.cat { background: var(--ink); color: var(--bg); border-color: var(--ink); }
    a.cat .cat__state { color: var(--p-accent); }
    .about__facts { margin-top: var(--s-6); }
    .about__pic { margin: 0; border-radius: var(--r-lg); overflow: hidden; }
    .about__pic img { display: block; width: 100%; height: auto; }
    .about__pic img { aspect-ratio: 4 / 5; object-fit: cover; }
    .draft-note { margin-top: var(--s-5); padding: var(--s-4); border: 1px dashed var(--line-strong); border-radius: var(--r-sm); font-size: var(--t-small); }
    @media (max-width: 1023px) {
      .hero-store__pic { margin-top: var(--s-7); }
      .cats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .about__pic { margin-top: var(--s-7); }
    }
    @media (max-width: 639px) {
      .hero--store { height: auto; min-height: 100svh; }
      .cats { grid-template-columns: minmax(0, 1fr); }
      .cat { min-height: 0; }
    }
  </style>

  <!-- 1. Hero: the publisher, with the one Book on sale as the main action (Q13) -->
  <section class="hero hero--store ground-inverse" data-enter aria-labelledby="hero-h">
    <div class="wrap">
      <div class="grid hero-store">
        <div class="span-6 hero-store__text">
          <p class="hero-store__label">Penerbit buku dari Ampang, Selangor</p>
          <h1 id="hero-h">Kedai buku <span class="hero-store__accent">Brainwave</span> Communications</h1>
          <p class="hero-store__lead">Beli terus dari penerbit. Buku pertama kami, <em>Siapa Akan Menguasai Putrajaya?</em> karya Ronifira Rejab, kini dibuka untuk pra-tempahan pada RM56 termasuk pos.</p>
          <div class="btn-row">
            <a class="btn btn--primary" href={`${BOOK}#tempah`}>Tempah buku<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8" /><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5" /></svg></a>
            <a class="btn btn--secondary" href="#pilihan">Lihat buku pilihan</a>
          </div>
        </div>
        <div class="span-6 start-7">
          <figure class="hero-store__pic"><img data-enter-media src="/img/bab-membaca.jpg" alt="Seorang lelaki membaca buku Siapa Akan Menguasai Putrajaya? di bilik bacaan" width="1600" height="894" fetchpriority="high" data-source="client" data-subject="a reader with the book" /></figure>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Featured Books: a static grid for now (Q8) -->
  <section class="section" id="pilihan" aria-labelledby="pilihan-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="pilihan-h">Buku pilihan. <span class="muted">Terus dari penerbit, pos termasuk dalam harga.</span></h2>
      </div>
      <ul class="shelf" role="list">
        {featured.map((book) => (
          <li><BookCard {...book} /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Books Category: Upcoming Categories show as "Akan datang" with no link (Q6, Q26) -->
  <section class="section" id="kategori" aria-labelledby="kategori-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="kategori-h">Kategori buku. <span class="muted">Lima lagi akan menyusul.</span></h2>
      </div>
      <ul class="cats" role="list">
        {categories.map((category) => (
          <li>
            {category.upcoming ? (
              <div class="cat">
                <span class="cat__name">{category.label}</span>
                <span class="cat__state">Akan datang</span>
              </div>
            ) : (
              <a class="cat" href={`/${category.slug}`}>
                <span class="cat__name">{category.label}</span>
                <span class="cat__state">{category.count} buku</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. About Us: facts already on record only (Q14); the owner adds the story before launch -->
  <section class="section" id="tentang" aria-labelledby="tentang-h">
    <div class="wrap grid">
      <div class="span-6">
        <div class="section-head">
          <h2 id="tentang-h">Tentang Brainwave Communications</h2>
          <p>Kami penerbit buku di Ampang, Selangor. Buku pertama kami, <em>Siapa Akan Menguasai Putrajaya?</em>, diterbitkan bersama Prestasi Media.</p>
        </div>
        <ul class="rows rows--spec about__facts">
          <li><span class="rows__name">Syarikat</span><span class="rows__value">Brainwave Communications</span></li>
          <li><span class="rows__name">No. pendaftaran SSM</span><span class="rows__value">202203208117 (JM0967023-W)</span></li>
          <li><span class="rows__name">Alamat</span><span class="rows__value">Ukay Perdana, Ampang, Selangor</span></li>
          <li><span class="rows__name">Rakan penerbit</span><span class="rows__value">Prestasi Media</span></li>
        </ul>
        {SHOW_PLACEHOLDERS && (
          <p class="draft-note">Contoh, staging sahaja: cerita syarikat (bila bermula, mengapa menerbitkan buku) akan ditambah oleh pemilik sebelum dilancarkan.</p>
        )}
      </div>
      <div class="span-6 start-7">
        <figure class="about__pic"><img src="/img/tempah-putrajaya.jpg" alt="Bangunan Perdana Putra dan Masjid Putra di tepi tasik Putrajaya pada waktu malam" width="1200" height="1608" loading="lazy" data-source="client" data-subject="Putrajaya at night" /></figure>
      </div>
    </div>
  </section>

  <!-- 5. FAQ: shop-wide questions; book-specific ones stay on each Book Page (Q15) -->
  <section class="section" id="soalan" aria-labelledby="soalan-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="soalan-h">Soalan tentang membeli buku</h2>
        <p>Ada soalan lain? WhatsApp <a class="link" href="https://wa.me/60108725969">+6010 872 5969</a> atau <a class="link" href="mailto:ronifira@gmail.com">e-mel kami</a>.</p>
      </div>
      <div class="faq faq--wide">
        <div class="faq__item"><h3>Bila buku akan sampai?</h3><p>Buku pra-tempahan dihantar selepas cetakan selesai: 3 hingga 5 hari bekerja ke Semenanjung, 5 hingga 7 hari bekerja ke Sabah dan Sarawak.</p></div>
        <div class="faq__item"><h3>Adakah harga buku termasuk pos?</h3><p>Ya. Harga di setiap buku sudah termasuk pos, mengikut zon Semenanjung atau Sabah dan Sarawak.</p></div>
        <div class="faq__item"><h3>Bagaimana saya membayar buku?</h3><p>Melalui CHIP Collect: FPX, DuitNow QR, kad kredit atau debit, dan e-dompet.</p></div>
        <div class="faq__item"><h3>Bagaimana jika buku rosak semasa sampai?</h3><p>Hubungi kami dalam tempoh 7 hari dengan gambar kerosakan. Butirannya dalam <a class="link" href="/polisi-pemulangan">polisi pemulangan</a>.</p></div>
      </div>
    </div>
  </section>

  <!-- 6. Testimonials: built, hidden until real ones exist (Q4) -->
  {testimonials.length > 0 && (
    <section class="section" id="testimoni" aria-labelledby="testimoni-h">
      <div class="wrap">
        <div class="section-head"><h2 id="testimoni-h">Kata pembaca</h2></div>
        <div class="grid">
          {testimonials.map((t) => (
            <figure class="quote span-6">
              <blockquote>{t.quote}</blockquote>
              <figcaption><span class="person__name">{t.name}</span>, {t.detail}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 7. CTA and 8. Footer: the shared close and footer in KitLayout -->
</KitLayout>
