---
import KitLayout from "../layouts/KitLayout.astro";
const cover = encodeURI("/COVER 16 copy 2.jpg");
---

<KitLayout title="Tempahan diterima: Siapa Akan Menguasai Putrajaya?" description="Pengesahan tempahan buku Siapa Akan Menguasai Putrajaya? karya Ronifira Rejab.">
  <section class="section" aria-labelledby="ok-h">
    <div class="wrap grid">
      <div class="span-7">
        <div class="section-head">
          <h1 id="ok-h">Terima kasih. Tempahan anda diterima.</h1>
          <p class="t-lead">Resit dan butiran tempahan dihantar ke e-mel anda oleh CHIP Collect.</p>
        </div>
        <ul class="rows rows--spec">
          <li><span class="rows__name">Semenanjung</span><span class="rows__value">3 hingga 5 hari bekerja</span></li>
          <li><span class="rows__name">Sabah dan Sarawak</span><span class="rows__value">3 hingga 5 hari bekerja</span></li>
          <li><span class="rows__name">Nombor penjejakan</span><span class="rows__value">Melalui WhatsApp atau e-mel</span></li>
        </ul>
        <div class="btn-row" style="margin-top: var(--s-7)"><a class="btn btn--secondary" href="/">Kembali ke laman utama</a></div>
      </div>
      <div class="span-4 start-9">
        <div class="frame frame--photo" style="aspect-ratio: 1748 / 2480"><img class="frame__img" src={cover} alt="Kulit hadapan buku Siapa Akan Menguasai Putrajaya?" width="1748" height="2480" /></div>
      </div>
    </div>
  </section>
</KitLayout>
