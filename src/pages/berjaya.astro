---
const pageTitle = "Tempahan Berjaya | Siapa Akan Menguasai Putrajaya?";
const pageDescription =
  "Pengesahan pembayaran tempahan buku Siapa Akan Menguasai Putrajaya? karya Ronifira Rejab melalui CHIP Collect.";
---

<!doctype html>
<html lang="ms" class="scroll-smooth bg-putrajaya-navy text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="noindex" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="flex min-h-dvh flex-col bg-putrajaya-navy font-sans text-white antialiased selection:bg-yellow-400 selection:text-slate-950">
    <a
      href="#kandungan-utama"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-yellow-400 focus:px-4 focus:py-3 focus:text-sm focus:font-extrabold focus:text-slate-950 focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-white"
    >
      Langkau ke kandungan utama
    </a>

    <header class="border-b border-slate-800 bg-putrajaya-navy">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3 sm:px-6 lg:px-8">
        <a
          href="/"
          class="inline-flex min-h-[44px] items-center text-sm font-extrabold uppercase tracking-wider text-white transition hover:text-yellow-400 active:translate-y-px focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-400"
        >
          Menguasai <span class="ml-1 text-yellow-400">Putrajaya</span>
        </a>

        <nav aria-label="Navigasi Pengesahan">
          <a
            href="/"
            class="inline-flex min-h-[44px] items-center px-2 text-sm font-semibold text-slate-300 transition hover:text-white active:translate-y-px focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-400"
          >
            Laman Utama
          </a>
        </nav>
      </div>
    </header>

    <main
      id="kandungan-utama"
      class="flex flex-1 items-center justify-center px-5 py-12 sm:px-6 sm:py-20 lg:px-8"
    >
      <section
        aria-labelledby="confirmation-heading"
        class="w-full max-w-xl rounded-2xl border border-slate-700 bg-slate-900 p-6 sm:p-10"
      >
        <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-yellow-400 bg-putrajaya-navy text-yellow-400">
          <svg
            class="h-6 w-6"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 13l4 4L19 7"
            />
          </svg>
        </div>

        <p class="mt-5 text-xs font-bold uppercase tracking-widest text-yellow-400">
          Pengesahan Pembayaran CHIP Collect
        </p>

        <h1
          id="confirmation-heading"
          class="mt-2 text-[clamp(1.65rem,3.2vw,2.25rem)] font-extrabold leading-tight tracking-tight text-white"
        >
          Tempahan Berjaya Disahkan
        </h1>

        <p class="mt-4 text-base leading-relaxed text-slate-300 sm:text-lg">
          Terima kasih atas sokongan anda. Pembayaran anda telah berjaya
          diproses melalui CHIP Collect. Sila semak peti masuk e-mel anda untuk
          resit rasmi dan butiran tempahan. Kami akan menguruskan penghantaran
          naskhah anda dalam masa terdekat.
        </p>

        <dl class="mt-6 grid grid-cols-1 gap-3 rounded-xl border border-slate-700 bg-putrajaya-navy p-4 text-sm sm:grid-cols-2">
          <div>
            <dt class="text-xs font-medium uppercase tracking-wider text-slate-400">
              Judul Buku
            </dt>
            <dd class="mt-1 font-semibold text-white">
              Siapa Akan Menguasai Putrajaya?
            </dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wider text-slate-400">
              Pengedar Rasmi
            </dt>
            <dd class="mt-1 font-semibold text-white">
              Brainwave Communications
            </dd>
          </div>
        </dl>

        <div class="mt-8">
          <a
            href="/"
            class="inline-flex min-h-[48px] w-full items-center justify-center rounded-xl bg-yellow-400 px-8 py-3.5 text-base font-extrabold text-slate-950 transition hover:bg-yellow-300 active:translate-y-px active:bg-yellow-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-400 sm:w-auto"
          >
            Kembali ke Laman Utama
          </a>
        </div>
      </section>
    </main>

    <footer class="border-t border-slate-800 bg-putrajaya-navy py-8 text-center text-sm text-slate-300">
      <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
        <p class="font-semibold text-white">
          Siapa Akan Menguasai Putrajaya?: Karya Ronifira Rejab
        </p>
        <p class="mt-1.5 text-xs text-slate-300">
          <strong>Pengedar:</strong> Brainwave Communications, 2-1B, Jalan
          UP1/1, Ukay Perdana, 68000 Ampang, Selangor.
        </p>
        <p class="mt-3 text-xs text-slate-400">
          &copy; {new Date().getFullYear()} Hak Cipta Terpelihara. Semua
          transaksi dalam talian dilindungi oleh CHIP Collect.
        </p>
      </div>
    </footer>

    <style is:global>
      a[href],
      button:not(:disabled),
      select:not(:disabled),
      summary,
      label[for],
      label:has(input:not(:disabled)),
      input[type="radio"]:not(:disabled),
      input[type="checkbox"]:not(:disabled),
      [role="button"]:not([aria-disabled="true"]) {
        cursor: pointer;
      }

      button:disabled,
      select:disabled,
      input:disabled,
      textarea:disabled,
      [aria-disabled="true"] {
        cursor: not-allowed;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto !important;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>
