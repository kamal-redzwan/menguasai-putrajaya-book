}

const { src, caption, label = "Sorotan Video", poster } = Astro.props;
const encodedSrc = encodeURI(src);
---

<figure class="mx-auto my-8 w-full max-w-sm sm:my-10">
  <div class="mb-3 flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-slate-300">
    <span class="text-yellow-400">{label}</span>
